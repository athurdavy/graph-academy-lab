@prefix ex: <https://example.org/biblioteca/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://example.org/biblioteca/ontologia> a owl:Ontology ;
    dcterms:title "Ontología didáctica de una biblioteca ficticia"@es .

ex:Libro a owl:Class ; rdfs:label "Libro"@es .
ex:LibroDigital a owl:Class ; rdfs:subClassOf ex:Libro ;
    rdfs:label "Libro digital"@es .
ex:Autor a owl:Class ; rdfs:label "Autor"@es .

ex:escritoPor a owl:ObjectProperty ;
    rdfs:domain ex:Libro ; rdfs:range ex:Autor ;
    owl:inverseOf ex:escribio .
ex:escribio a owl:ObjectProperty .

ex:titulo a owl:DatatypeProperty ;
    rdfs:domain ex:Libro ; rdfs:range xsd:string .

ex:autor001 a ex:Autor ;
    rdfs:label "Marina Soler"@es .

ex:libro001 a ex:LibroDigital ;
    ex:titulo "El mapa de los grafos" ;
    ex:escritoPor ex:autor001 .

ex:libro002 a ex:Libro ;
    ex:titulo "Rutas de conocimiento" ;
    ex:escritoPor ex:autor001 .
